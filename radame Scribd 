bash  
#!/bin/bash
# ===========================================================
#  🛠️ TERMUX SALOMÓN TOOLBOX - AUTOMATIC EDITION v2.1
#  Repositorio: https://github.com/[TU_USUARIO]/termux-salomon-toolbox
#  Autor: Arquitecto José Isaías Álvarez Ramírez
#  Descripción: Caja de herramientas todo-en-uno para Termux.
#  Funciones: Monitoreo • Análisis • Red • Batería • Respaldo
#  Licencia: Uso exclusivo del autor - Todos los derechos reservados
# ===========================================================

clear
echo "====================================================="
echo "   🤖 TERMUX SALOMÓN TOOLBOX • AUTO MODE 🤖"
echo "   Sistema de Diagnóstico y Mantenimiento v2.1"
echo "====================================================="
echo " Fecha: $(date +'%d/%m/%Y') | Hora: $(date +'%H:%M:%S')"
echo " Usuario: $(whoami) | Equipo: Moto G85 5G"
echo "====================================================="
echo ""

# ===========================================================
# 💾 MÓDULO 1: ANÁLISIS DE ALMACENAMIENTO
# ===========================================================
echo "💾 [1/5] ESPACIO EN DISCO:"
echo "-----------------------------------------------------"
df -h . | awk 'NR==1 || NR==2 {print "  " $0}'
echo ""

# ===========================================================
# 📂 MÓDULO 2: DETECCIÓN DE ARCHIVOS PESADOS
# ===========================================================
echo "📂 [2/5] ESCANEANDO ARCHIVOS MÁS GRANDES (TOP 10):"
echo "-----------------------------------------------------"
echo "  ⏳ Analizando estructura de archivos..."
find ~ -type f -exec du -h {} + 2>/dev/null | sort -rh | head -n 10 | awk '{print "  • " $2 " -> " $1}'
echo "  ✅ Escaneo completado."
echo ""

# ===========================================================
# 🌐 MÓDULO 3: PRUEBA DE CONECTIVIDAD A INTERNET
# ===========================================================
echo "🌐 [3/5] ESTADO DE LA RED:"
echo "-----------------------------------------------------"
if ping -c 2 1.1.1.1 > /dev/null 2>&1; then
    echo "  🟢 CONEXIÓN: ESTABLE • ACCESO GLOBAL ✅"
else
    echo "  🔴 CONEXIÓN: SIN ACCESO O RESTRINGIDA ⚠️"
fi
echo ""

# ===========================================================
# 🔋 MÓDULO 4: MONITOREO DE ENERGÍA Y HARDWARE
# ===========================================================
echo "🔋 [4/5] ESTADO DE LA BATERÍA:"
echo "-----------------------------------------------------"
SYS_BATT="/sys/class/power_supply/battery"
if [ -d "$SYS_BATT" ]; then
    CAPACITY=$(cat "$SYS_BATT"/capacity 2>/dev/null)
    STATUS=$(cat "$SYS_BATT"/status 2>/dev/null)
    HEALTH=$(cat "$SYS_BATT"/health 2>/dev/null)
    echo "  • CARGA: $CAPACITY% | ESTADO: $STATUS"
    echo "  • SALUD: $HEALTH"
else
    echo "  • DATOS: Protegidos por el sistema o instala termux-api"
fi
echo ""

# ===========================================================
# 📦 MÓDULO 5: RESPALDO AUTOMÁTICO INTELIGENTE
# ===========================================================
echo "📦 [5/5] EJECUTANDO COPIA DE SEGURIDAD..."
echo "-----------------------------------------------------"
mkdir -p ~/salomon_backups
FECHA_ARCHIVO=$(date +'%Y%m%d_%H%M%S')
NOMBRE_ARCHIVO="salomon_backup_${FECHA_ARCHIVO}.tar.gz"

tar -czf ~/salomon_backups/$NOMBRE_ARCHIVO -C ~/ ./.termux ./scripts 2>/dev/null

if [ $? -eq 0 ]; then
    echo "  ✅ RESPALDO CREADO EXITOSAMENTE"
    echo "     📁 Archivo: $NOMBRE_ARCHIVO"
    echo "     📂 Ruta: ~/salomon_backups/"
    echo "     📊 Tamaño: $(du -h ~/salomon_backups/$NOMBRE_ARCHIVO | cut -f1)"
else
    echo "  ❌ ERROR: No se pudo generar el respaldo"
fi

echo ""
echo "====================================================="
echo "   🟢 PROCESO FINALIZADO • SISTEMA SALOMÓN 2026"
echo "   REPOSITORIO: github.com/[TU_USUARIO] 🚀"
echo "====================================================="
 
 
 
 
