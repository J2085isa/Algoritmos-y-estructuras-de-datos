#!/data/data/com.termux/files/usr/bin/bash
# ==========================================================
# ⚜️ AGENTE DE RECORRIDO SEGURO · DISPOSITIVO ↔ TERMUX ↔ GITHUB ⚜️
# RECORRE · VERIFICA · CIFRA · SUBE · CONFIRMA ✅
